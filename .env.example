# Local API server
PORT=8787
CORS_ORIGIN=http://127.0.0.1:5173

# Optional local Codex CLI binary. The CLI reads its own ChatGPT login state;
# this server never receives or stores the token.
# Leave unset to prefer the desktop Codex runtime on macOS; explicit paths override.
# CODEX_CLI_PATH=/path/to/codex
CODEX_TIMEOUT_MS=120000
CODEX_VERIFY_TIMEOUT_MS=240000

# 模型和推理强度由顶部 AI 设置按用途选择，存于本机偏好。

# Hosted trial only (never use VITE_ for secrets). Requires a durable private directory.
# Initialize explicitly once: tsx server/hosted-index.ts --init-budget
DEEPSEEK_API_KEY=
HOSTED_ORIGIN=https://gotit.bingbryan.com
HOSTED_PORT=8788
HOSTED_BUDGET_PATH=
HOSTED_STATISTICS_PATH=
# Optional smaller daily cap for isolated paid QA (never greater than 3 USD).
HOSTED_DAILY_BUDGET_USD=3
# Paid QA harness only; do not set these for production.
HOSTED_QA_REPORT_PATH=
HOSTED_QA_IMAGE_PATH=

# Hosted search only. Leave price empty until the operator verifies current billing.
BOCHA_API_KEY=
BOCHA_API_ORIGIN=https://api.bocha.cn
HOSTED_SEARCH_MAX_COST_USD=
# Set to 1 to let the hosted trial read user-selected PDF regions; leave empty to keep it off.
HOSTED_ENABLE_IMAGES=
